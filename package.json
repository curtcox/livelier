{
  "name": "livelier",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/browser/all.cjs",
    "docs": "node scripts/render-docs.mjs",
    "gallery": "node scripts/render-gallery.mjs",
    "offline": "node scripts/update-offline.mjs",
    "serve": "python3 -m http.server 8000",
    "test:urls": "node tests/browser/url-state.cjs",
    "gallery:world": "node scripts/render-world-previews.mjs",
    "test:contracts": "playwright test --config vendor/fragment-kit-v0.4.3/testing/playwright.config.js",
    "test:ai:browser": "node tests/browser/ai.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "@playwright/test": "1.64.1"
  }
}
