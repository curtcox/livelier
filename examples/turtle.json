  "src": "const paper=world.addMorph(new CanvasMorph({position:pt(30,160),extent:pt(600,390),fill:'#fffdf5'}));\npaper.draw(ctx=>{ctx.clearRect(0,0,600,390);ctx.save();ctx.translate(300,195);ctx.lineWidth=1.5;for(let i=0;i<160;i++){ctx.strokeStyle='hsl('+i*3+' 35% 55%)';ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(i*1.5,0);ctx.stroke();ctx.translate(i*1.5,0);ctx.rotate(2.4);}ctx.restore();});",
