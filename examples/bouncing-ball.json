  "src": "const ball=world.addMorph(new Ellipse({position:pt(90,180),extent:pt(60,60),fill:'#d8a15f'}));\nball.addScript(function step(){\n  this.vx ??= 3; this.vy ??= 2;\n  const p=this.position;\n  if(p.x<10||p.x>Math.min(innerWidth-70,650)) this.vx *= -1;\n  if(p.y<160||p.y>Math.min(innerHeight-70,540)) this.vy *= -1;\n  this.position=p.add(pt(this.vx,this.vy));\n});\nball.startStepping(16);",
