  "src": "const cols=22,rows=15,cells=[];\nfor(let y=0;y<rows;y++)for(let x=0;x<cols;x++){const cell=world.addMorph(new Morph({name:'cell-'+x+'-'+y,position:pt(30+x*25,165+y*25),extent:pt(23,23),fill:Math.random()<.3?'#729878':'#e2e8d9',borderRadius:3,draggable:false}));cell.addScript(function onMouseUp(){this.fill=this.fill==='#729878'?'#e2e8d9':'#729878';});cells.push(cell);}\nsetInterval(()=>{const alive=cells.map(c=>c.fill==='#729878');cells.forEach((c,i)=>{const x=i%cols,y=Math.floor(i/cols);let n=0;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){if(!(dx||dy))continue;const xx=x+dx,yy=y+dy;if(xx>=0&&xx<cols&&yy>=0&&yy<rows&&alive[yy*cols+xx])n++;}c.fill=n===3||(alive[i]&&n===2)?'#729878':'#e2e8d9';});},300);",
