  "src": "const bars=Array.from({length:22},(_,i)=>world.addMorph(new Morph({position:pt(30+i*26,180),extent:pt(22,40+Math.random()*240),fill:'#92af94',borderRadius:3})));\nlet i=0,j=0;\nconst timer=setInterval(()=>{if(i>=bars.length){clearInterval(timer);return;}if(j>=bars.length-i-1){j=0;i++;return;}const a=bars[j],b=bars[j+1];if(a.extent.y>b.extent.y){const p=a.position;a.position=b.position;b.position=p;[bars[j],bars[j+1]]=[b,a];}j++;},60);",
