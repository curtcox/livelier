  "src": "const center=pt(320,340);\nworld.addMorph(new Ellipse({position:center.sub(pt(150,150)),extent:pt(300,300),fill:'#fffdf5',borderWidth:2,borderColor:'#92a48b'}));\nfor(let i=0;i<12;i++){const a=i*Math.PI/6;world.addMorph(new Ellipse({position:center.add(pt(Math.sin(a)*130-3,-Math.cos(a)*130-3)),extent:pt(6,6),fill:'#7b9277'}));}\nfor(const [kind,length,color] of [['hours',75,'#3c6050'],['minutes',110,'#3c6050'],['seconds',120,'#c38754']]){\n const hand=world.addMorph(new Path({position:center,extent:pt(1,1),vertices:[pt(0,0),pt(0,-length)],stroke:color,strokeWidth:kind==='seconds'?2:5}));\n hand.name=kind;\n hand.addScript(function step(){const d=new Date();this.rotation=(this.name==='hours'?(d.getHours()%12+d.getMinutes()/60)/12:this.name==='minutes'?(d.getMinutes()+d.getSeconds()/60)/60:d.getSeconds()/60)*Math.PI*2;});\n hand.startStepping(100);\n}",
